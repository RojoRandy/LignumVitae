<!doctype html>
<html lang="es-MX">
<head>
<meta charset="utf-8" />
<style>
  /* Paleta de marca: todos los valores, incluido --paper, vienen de packages/tailwind-preset/brand.json; mismo
     criterio que apps/admin/src/styles/tokens.css. Ningun otro hex en esta plantilla. */
  :root {
    --accent: #3D6660;         /* teal-700 */
    --ink: #26302A;            /* ink */
    --muted: #5C6E63;          /* moss-600 */
    --surface-sunken: #F7F4EC; /* cream-50 */
    --border-strong: #B2CBAE;  /* sage-300 */
    --border: #E9E3D3;         /* cream-100 */
    --paper: #FFFFFF;          /* token "paper" de packages/tailwind-preset/brand.json (#FFFFFF): fondo explicito, el PNG no trae papel blanco como el PDF */
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; color: var(--ink); background: var(--paper); margin: 0; padding: 0; font-size: 12px; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; padding: 32px 32px 16px; border-bottom: 2px solid var(--accent); }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand img { height: 64px; width: 64px; }
  .brand-name { font-size: 22px; font-weight: 700; color: var(--accent); }
  .contact { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .doc-info { text-align: right; }
  .doc-title { font-size: 18px; font-weight: 700; }
  .folio { font-size: 13px; color: var(--muted); }
  .dates { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .section { padding: 16px 32px; }
  .customer-box { background: var(--surface-sunken); border-radius: 8px; padding: 12px 16px; }
  .customer-box .name { font-weight: 700; font-size: 14px; }
  table { width: 100%; border-collapse: collapse; margin-top: 8px; }
  th { text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); padding: 6px 8px; border-bottom: 1px solid var(--border-strong); }
  td { padding: 8px; border-bottom: 1px solid var(--border); font-size: 11px; vertical-align: top; }
  .num { text-align: right; white-space: nowrap; }
  .detail { color: var(--muted); font-size: 10px; }
  .totals { width: 280px; margin-left: auto; margin-top: 12px; }
  .totals .row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 12px; }
  .totals .total-row { font-weight: 700; font-size: 15px; border-top: 2px solid var(--ink); padding-top: 8px; margin-top: 4px; }
  .totals .deposit-row { color: var(--accent); font-weight: 700; }
  .product { display: flex; align-items: center; gap: 8px; }
  .product img { width: 40px; height: 40px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); }
  .bank { width: 280px; margin-left: auto; margin-top: 16px; background: var(--surface-sunken); border-radius: 8px; padding: 10px 14px; font-size: 11px; }
  .bank .title { font-weight: 700; color: var(--accent); margin-bottom: 4px; }
  .bank .row { display: flex; justify-content: space-between; gap: 12px; padding: 2px 0; }
  .bank .label { color: var(--muted); }
  .bank .value { font-weight: 600; letter-spacing: 0.02em; }
  .terms { margin-top: 24px; font-size: 10px; color: var(--muted); white-space: pre-line; }
  .footer { padding: 16px 32px 32px; font-size: 10px; color: var(--muted); text-align: center; }
  .layout-mobile { font-size: 13px; }
  .layout-mobile .header, .layout-mobile .section, .layout-mobile .footer { padding-left: 16px; padding-right: 16px; }
  .layout-mobile .header { flex-direction: column; gap: 16px; }
  .layout-mobile .doc-info { text-align: left; }
  .layout-mobile .brand, .layout-mobile .brand > div, .layout-mobile .product span { min-width: 0; overflow-wrap: anywhere; }
  .layout-mobile .brand img, .layout-mobile .product img { flex-shrink: 0; }
  .layout-mobile table, .layout-mobile tbody, .layout-mobile tr, .layout-mobile td { display: block; }
  .layout-mobile thead { display: none; }
  .layout-mobile tbody tr { break-inside: avoid; page-break-inside: avoid; display: grid; grid-template-columns: 1fr; border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin-bottom: 12px; }
  .layout-mobile tbody tr.has-img { grid-template-columns: 96px 1fr; column-gap: 12px; }
  .layout-mobile td { padding: 4px 0; border-bottom: 0; font-size: 13px; }
  .layout-mobile td.product-cell, .layout-mobile .product { display: contents; }
  .layout-mobile .product img { width: 96px; height: 96px; object-fit: cover; border-radius: 8px; grid-column: 1; grid-row: 1 / span 2; }
  .layout-mobile .product span { grid-column: 1; grid-row: 1; padding: 4px 0; }
  .layout-mobile td.detail { grid-column: 1; grid-row: 2; min-width: 0; font-size: 12px; margin-bottom: 8px; overflow-wrap: anywhere; }
  .layout-mobile .has-img .product span, .layout-mobile .has-img td.detail { grid-column: 2; }
  .layout-mobile td.nums { grid-column: 1 / -1; grid-row: 3; display: grid; grid-template-columns: max-content minmax(max-content, 1fr) minmax(max-content, 1fr); column-gap: 12px; }
  .layout-mobile .nums .num { display: grid; grid-template-columns: auto; text-align: left; align-content: start; }
  .layout-mobile .nums .num::before { content: attr(data-label); grid-column: 1; grid-row: 1; font-size: 11px; color: var(--muted); margin-bottom: 4px; font-weight: 400; }
  .layout-mobile .nums .num > span { grid-column: 1; grid-row: 2; }
  .layout-mobile .nums .quantity { grid-template-columns: auto auto; column-gap: 12px; }
  .layout-mobile .nums .quantity::after { content: '×'; grid-column: 2; grid-row: 2; color: var(--muted); }
  .layout-mobile .nums .amount { text-align: right; font-weight: 700; }
  .layout-mobile .totals, .layout-mobile .bank { width: 100%; }
</style>
</head>
<body class="layout-{{layout}}">
  <div class="header">
    <div class="brand">
      <img src="{{logoSrc}}" alt="{{brandName}}" />
      <div>
        <div class="brand-name">{{brandName}}</div>
        <div class="contact">{{phone}}{{#if whatsapp}} &middot; WhatsApp {{whatsapp}}{{/if}}{{#if email}} &middot; {{email}}{{/if}}</div>
      </div>
    </div>
    <div class="doc-info">
      <div class="doc-title">Cotizacion</div>
      <div class="folio">{{folio}}</div>
      <div class="dates">Emitida: {{date issuedAt}}<br />Vigente hasta: {{date validUntil}}</div>
    </div>
  </div>

  <div class="section">
    <div class="customer-box">
      <div class="name">{{customer.fullName}}</div>
      {{#if customer.phone}}<div>{{customer.phone}}</div>{{/if}}
      {{#if customer.address}}<div>{{customer.address}}</div>{{/if}}
      {{#if eventDate}}<div style="margin-top: 6px;">Fecha del evento: {{date eventDate}}</div>{{/if}}
    </div>

    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Detalle</th>
          <th class="num">Cant.</th>
          <th class="num">Precio</th>
          <th class="num">Importe</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr class="{{#if imageUrl}}has-img{{/if}}">
          <td class="product-cell"><div class="product">{{#if imageUrl}}<img src="{{imageUrl}}" alt="" />{{/if}}<span>{{product.name}}</span></div></td>
          <td class="detail">
            {{#if candleColor}}Color: {{candleColor}}<br />{{/if}}
            {{#if ribbonColor}}Liston: {{ribbonColor}}<br />{{/if}}
            {{#each extraFields}}{{label}}: {{value}}<br />{{/each}}
            {{#if withFragrance}}Aroma: {{#if fragranceSupply.name}}{{fragranceSupply.name}}{{else}}Pendiente{{/if}}<br />{{/if}}
            {{#if personalizationText}}{{personalizationText}}{{/if}}
          </td>
          {{!-- layout es 'letter' | 'mobile': en movil los tres valores van en una sola celda con su propia rejilla. --}}
          {{#if (eq @root.layout 'mobile')}}
          <td class="nums">
            <span class="num quantity" data-label="Cant."><span>{{quantity}}</span></span>
            <span class="num" data-label="Precio"><span>{{money unitPrice}}</span></span>
            <span class="num amount" data-label="Importe"><span>{{money lineTotal}}</span></span>
          </td>
          {{else}}
          <td class="num" data-label="Cant.">{{quantity}}</td>
          <td class="num" data-label="Precio">{{money unitPrice}}</td>
          <td class="num" data-label="Importe">{{money lineTotal}}</td>
          {{/if}}
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="totals">
      <div class="row"><span>Subtotal</span><span>{{money subtotal}}</span></div>
      {{#if discountEnabled}}<div class="row"><span>Descuento</span><span>-{{money discountAmount}}</span></div>{{/if}}
      {{#if (gt shippingCost 0)}}<div class="row"><span>Envio</span><span>{{money shippingCost}}</span></div>{{/if}}
      <div class="row total-row"><span>Total</span><span>{{money total}}</span></div>
      <div class="row deposit-row"><span>Anticipo requerido</span><span>{{money depositAmount}}</span></div>
    </div>

    {{#if bankAccount}}
    <div class="bank">
      <div class="title">Datos para transferencia</div>
      {{#if bankAccount.bankName}}<div class="row"><span class="label">Banco</span><span class="value">{{bankAccount.bankName}}</span></div>{{/if}}
      {{#if bankAccount.accountHolder}}<div class="row"><span class="label">Beneficiario</span><span class="value">{{bankAccount.accountHolder}}</span></div>{{/if}}
      {{#if bankAccount.clabe}}<div class="row"><span class="label">CLABE</span><span class="value">{{bankAccount.clabe}}</span></div>{{/if}}
      {{#if bankAccount.cardNumber}}<div class="row"><span class="label">Tarjeta</span><span class="value">{{bankAccount.cardNumber}}</span></div>{{/if}}
    </div>
    {{/if}}

    {{#if terms}}<div class="terms">{{terms}}</div>{{/if}}
    {{#if notes}}<div class="terms">{{notes}}</div>{{/if}}
  </div>

  <div class="footer">
    {{publicUrl}}
  </div>
</body>
</html>

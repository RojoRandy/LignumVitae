---
import Layout from '../layouts/Layout.astro';
import ProductCard, { type Product } from '../components/ProductCard.astro';
import PriceDisclaimer from '../components/PriceDisclaimer.astro';
import { getJson } from '../lib/api';
import type { PriceSettings } from '../lib/price';
import { facetVisible, filtersFromSearch, flattenCatalog, matchesFilters } from '../lib/catalog-filter';

interface Category {
  name: string;
  slug: string;
  products: Product[];
}

const categories = await getJson<Category[]>('/public/catalog');
// Solo para el umbral de mayoreo y el cargo por aroma del aviso de precios: si falla,
// el aviso sale sin ese dato y el catalogo no se cae.
const settings = await getJson<PriceSettings>('/public/settings').catch(() => null);
const items = flattenCatalog(categories);
const hasProducts = items.length > 0;

// Solo los moldes que de verdad se usan en el catalogo visible, deduplicados
// por slug: un mismo molde se repite entre productos y hasta entre los
// componentes de varios ramos.
const candlesBySlug = new Map<string, { name: string; slug: string; categorySlugs: Set<string> }>();
const packagingBySlug = new Map<string, { name: string; slug: string; categorySlugs: Set<string> }>();
for (const category of categories) {
  for (const product of category.products) {
    for (const candle of product.candles ?? []) {
      if (!candlesBySlug.has(candle.slug)) {
        candlesBySlug.set(candle.slug, { ...candle, categorySlugs: new Set() });
      }
      candlesBySlug.get(candle.slug)!.categorySlugs.add(category.slug);
    }
    const pkg = product.packagingType;
    if (pkg) {
      if (!packagingBySlug.has(pkg.slug)) {
        packagingBySlug.set(pkg.slug, { ...pkg, categorySlugs: new Set() });
      }
      packagingBySlug.get(pkg.slug)!.categorySlugs.add(category.slug);
    }
  }
}
const candleFacets = Array.from(candlesBySlug.values()).sort((a, b) => a.name.localeCompare(b.name, 'es'));
const packagingFacets = Array.from(packagingBySlug.values()).sort((a, b) => a.name.localeCompare(b.name, 'es'));

// Filtros del enlace compartido (?c=&m=&e=&q=): se pintan desde el servidor
// para que la pagina llegue ya filtrada; el script del cliente los mantiene
// sincronizados con la URL.
const parsed = filtersFromSearch(Astro.url.search, {
  categories: categories.map((category) => category.slug),
  candles: candleFacets.map((candle) => candle.slug),
  packagings: packagingFacets.map((pkg) => pkg.slug),
});
const initial = {
  ...parsed,
  candles: parsed.candles.filter((slug) => facetVisible([...candlesBySlug.get(slug)!.categorySlugs], parsed.categories)),
  packagings: parsed.packagings.filter((slug) => facetVisible([...packagingBySlug.get(slug)!.categorySlugs], parsed.categories)),
};
const initiallyVisible = (product: Product, categorySlug: string) => matchesFilters({
  name: product.name,
  category: categorySlug,
  candles: (product.candles ?? []).map((candle) => candle.slug),
  packaging: product.packagingType?.slug ?? '',
}, initial);
---

<Layout title="Catálogo · Lignum Vitae" description="Explora nuestras velas personalizadas por categoría y molde, y encuentra un recuerdo para tu celebración.">
  <div class="site-container pt-6 pb-4 lg:pt-10 lg:pb-6">
    <h1 class="text-heading text-brand">Catálogo</h1>
    {!hasProducts && <p class="mt-4 text-body text-text-muted">Estamos preparando nuestro catálogo. Contáctanos para conocer las opciones disponibles.</p>}
  </div>

  {categories.length > 0 && (
    <>
    <div class="site-container grid gap-6 pb-16 lg:grid-cols-[240px_minmax(0,1fr)] lg:items-start lg:pb-24">
      <aside class="lg:sticky lg:top-24 lg:max-h-[calc(100dvh-7rem)] lg:overflow-y-auto">
        <div class="flex items-center gap-2 lg:mb-4">
          <label for="catalog-search" class="sr-only">Buscar por nombre</label>
          <input id="catalog-search" type="search" data-filter-search value={initial.query} placeholder="Buscar vela…" autocomplete="off" class="field-input min-w-0 flex-1" />
          <button type="button" data-filters-toggle aria-label="Filtros" aria-haspopup="dialog" aria-controls="catalog-filters-dialog" class="relative flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-border-strong bg-surface text-text lg:hidden">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
            <span data-filters-count aria-hidden="true" hidden class="absolute -top-1 -right-1 flex h-5 min-w-5 items-center justify-center rounded-full bg-action px-1 text-micro text-surface [&[hidden]]:hidden"></span>
          </button>
        </div>
        <div class="filters-panel">
          <div id="catalog-filters" class="filters-body hidden flex-col gap-6 lg:flex">
            <fieldset>
              <legend class="text-body-sm font-medium text-text">Categoría</legend>
              <div class="mt-3 flex flex-col gap-1">
                {categories.map((category) => <label class="flex min-h-9 items-center gap-2 text-body-sm text-text">
                  <input type="checkbox" data-filter-category value={category.slug} checked={initial.categories.includes(category.slug)} class="h-4 w-4 accent-action" />
                  {category.name}
                </label>)}
              </div>
            </fieldset>
            {candleFacets.length > 0 && <fieldset>
              <legend class="text-body-sm font-medium text-text">Molde</legend>
              <div class="mt-3 flex flex-col gap-1">
                {candleFacets.map((candle) => <label data-facet-categories={[...candle.categorySlugs].join(',')} class="flex min-h-9 items-center gap-2 text-body-sm text-text">
                  <input type="checkbox" data-filter-candle value={candle.slug} checked={initial.candles.includes(candle.slug)} class="h-4 w-4 accent-action" />
                  {candle.name}
                </label>)}
              </div>
            </fieldset>}
            {packagingFacets.length > 0 && <fieldset>
              <legend class="text-body-sm font-medium text-text">Empaque</legend>
              <div class="mt-3 flex flex-col gap-1">
                {packagingFacets.map((pkg) => <label data-facet-categories={[...pkg.categorySlugs].join(',')} class="flex min-h-9 items-center gap-2 text-body-sm text-text">
                  <input type="checkbox" data-filter-packaging value={pkg.slug} checked={initial.packagings.includes(pkg.slug)} class="h-4 w-4 accent-action" />
                  {pkg.name}
                </label>)}
              </div>
            </fieldset>}
            <button type="button" data-clear-filters class="self-start text-body-sm text-action underline" hidden>Limpiar filtros</button>
          </div>
        </div>
      </aside>

      <div class="catalog-results min-w-0">
        <p id="catalog-empty" class="mt-4 text-body text-text-muted" hidden>
          No hay productos con esos filtros. <button type="button" data-clear-filters class="text-action underline">Limpiar filtros</button>
        </p>

        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:mt-4 lg:gap-6">
          {items.map(({ product, categorySlug }) => <ProductCard product={product} categorySlug={categorySlug} hidden={!initiallyVisible(product, categorySlug)} />)}
        </div>
        {hasProducts && <PriceDisclaimer class="mt-6" wholesaleThresholdQty={settings?.wholesaleThresholdQty} fragranceSurcharge={settings?.fragranceSurcharge} />}
      </div>
    </div>
    <dialog id="catalog-filters-dialog" aria-labelledby="catalog-filters-title" class="m-0 h-dvh max-h-none w-full max-w-none bg-canvas p-0 text-text backdrop:bg-ink/60 open:flex open:flex-col">
      <header class="flex items-center justify-between border-b border-border px-4 py-2">
        <h2 id="catalog-filters-title" class="text-heading-sm text-brand">Filtros</h2>
        <button type="button" data-filters-close aria-label="Cerrar" class="button h-11 min-h-11 w-11 p-0 text-text">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </header>
      <div data-filters-slot class="flex-1 overflow-y-auto p-4 [&>#catalog-filters]:flex"></div>
      <footer class="flex gap-3 border-t border-border p-4">
        <button type="button" data-clear-all disabled class="button button-outline shrink-0 disabled:cursor-not-allowed disabled:opacity-50">Limpiar</button>
        <button type="button" data-filters-close data-filters-results class="button flex-1 bg-action text-surface hover:bg-action-hover">Ver productos</button>
      </footer>
    </dialog>
    </>
  )}
</Layout>

<style>
  :global(html:has(#catalog-filters-dialog[open])) { overflow: hidden; }
  /* Header (64/80px) + aire para el foco. */
  :global(html:has(.catalog-results)) { scroll-padding-top: 5rem; }
  @media (min-width: 768px) {
    :global(html:has(.catalog-results)) { scroll-padding-top: 6rem; }
  }
  .catalog-results { overflow-anchor: none; }
  /* En el modal, "Limpiar" del footer reemplaza al enlace del panel. */
  [data-filters-slot] [data-clear-filters] { display: none; }
</style>

<script>
  import { activeFilterCount, categoryFromHash, facetVisible, filtersFromSearch, filtersToSearch, matchesFilters, normalizeText, resultsLabel } from '../lib/catalog-filter';

  const searchInput = document.querySelector<HTMLInputElement>('[data-filter-search]');
  const categoryCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-category]'));
  const candleCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-candle]'));
  const packagingCheckboxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-packaging]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  const emptyState = document.querySelector<HTMLElement>('#catalog-empty');
  const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]'));
  const results = document.querySelector<HTMLElement>('.catalog-results');
  const filtersToggle = document.querySelector<HTMLButtonElement>('[data-filters-toggle]');
  const filtersBody = document.querySelector<HTMLElement>('#catalog-filters');
  const filtersCount = document.querySelector<HTMLElement>('[data-filters-count]');

  const filtersDialog = document.querySelector<HTMLDialogElement>('#catalog-filters-dialog');
  const filtersSlot = filtersDialog?.querySelector<HTMLElement>('[data-filters-slot]');
  const filtersHome = document.querySelector<HTMLElement>('.filters-panel');
  const resultsButton = document.querySelector<HTMLElement>('[data-filters-results]');
  const clearAllButton = document.querySelector<HTMLButtonElement>('[data-clear-all]');

  filtersToggle?.addEventListener('click', () => {
    if (!filtersDialog || !filtersSlot || !filtersBody) return;
    filtersSlot.append(filtersBody);
    filtersDialog.showModal();
  });

  document.querySelectorAll('[data-filters-close]').forEach((button) => {
    button.addEventListener('click', () => filtersDialog?.close());
  });

  filtersDialog?.addEventListener('close', () => {
    if (filtersHome && filtersBody) filtersHome.append(filtersBody);
    if (filtersToggle) keepResultsInView(filtersToggle);
  });

  const desktop = window.matchMedia('(min-width: 1024px)');
  desktop.addEventListener('change', () => {
    if (desktop.matches && filtersDialog?.open) filtersDialog.close();
  });

  const keepResultsInView = (source: HTMLElement) => {
    requestAnimationFrame(() => {
      if (source.closest('dialog[open]')) return;
      if (!results) return;
      const resultsRect = results.getBoundingClientRect();
      // En una columna, conserva la vista del usuario sobre los filtros.
      if (source instanceof HTMLInputElement && source.closest('.filters-panel') && source.getBoundingClientRect().top < resultsRect.top) return;
      const scrollPaddingTop = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      if (resultsRect.top < scrollPaddingTop) {
        window.scrollTo({ top: window.scrollY + resultsRect.top - scrollPaddingTop, behavior: 'auto' });
      }
    });
  };

  const selected = (checkboxes: HTMLInputElement[]) => checkboxes.filter((c) => c.checked).map((c) => c.value);

  const applyFilters = () => {
    const query = searchInput?.value ?? '';
    const categories = selected(categoryCheckboxes);
    [candleCheckboxes, packagingCheckboxes].forEach((checkboxes) => {
      checkboxes.forEach((checkbox) => {
        const label = checkbox.closest('label');
        if (!label) return;
        const categorySlugs = (label.dataset.facetCategories ?? '').split(',');
        label.hidden = !facetVisible(categorySlugs, categories);
        if (label.hidden) checkbox.checked = false;
      });
      const fieldset = checkboxes[0]?.closest('fieldset');
      if (fieldset) {
        fieldset.hidden = Array.from(fieldset.querySelectorAll('label')).every((label) => label.hidden);
      }
    });
    const candles = selected(candleCheckboxes);
    const packagings = selected(packagingCheckboxes);
    const count = activeFilterCount({ categories, candles, packagings });
    if (filtersCount) {
      filtersCount.textContent = String(count);
      filtersCount.hidden = count === 0;
    }
    filtersToggle?.setAttribute('aria-label', count > 0 ? `Filtros (${count})` : 'Filtros');
    const anyFilter = categories.length > 0 || candles.length > 0 || packagings.length > 0 || normalizeText(query) !== '';

    let visibleCount = 0;
    cards.forEach((card) => {
      const cardCategory = card.dataset.category ?? '';
      const cardCandles = (card.dataset.candles ?? '').split(',').filter(Boolean);
      const cardPackaging = card.dataset.packaging ?? '';
      const visible = matchesFilters(
        { name: card.querySelector('h3')?.textContent ?? '', category: cardCategory, candles: cardCandles, packaging: cardPackaging },
        { categories, candles, packagings, query },
      );
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    if (resultsButton) resultsButton.textContent = resultsLabel(visibleCount);

    clearButtons.forEach((button) => { button.hidden = !anyFilter; });
    if (clearAllButton) clearAllButton.disabled = !anyFilter;
    if (emptyState) emptyState.hidden = !anyFilter || visibleCount > 0;

    // replaceState y no pushState: cada clic no debe llenar el historial de "Atras".
    const url = location.pathname + filtersToSearch({ categories, candles, packagings, query });
    if (url !== location.pathname + location.search + location.hash) history.replaceState(history.state, '', url);
  };

  searchInput?.addEventListener('input', applyFilters);

  [...categoryCheckboxes, ...candleCheckboxes, ...packagingCheckboxes].forEach((checkbox) => checkbox.addEventListener('change', () => {
    applyFilters();
    keepResultsInView(checkbox);
  }));

  [...clearButtons, ...(clearAllButton ? [clearAllButton] : [])].forEach((button) => button.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    categoryCheckboxes.forEach((checkbox) => { checkbox.checked = false; });
    candleCheckboxes.forEach((checkbox) => { checkbox.checked = false; });
    packagingCheckboxes.forEach((checkbox) => { checkbox.checked = false; });
    applyFilters();
    keepResultsInView(button);
  }));

  // El servidor ya marca los filtros de ?c=&m=&e=&q=; se vuelven a aplicar
  // aqui por si el navegador restauro otro estado del formulario.
  const values = (checkboxes: HTMLInputElement[]) => checkboxes.map((checkbox) => checkbox.value);
  const initial = filtersFromSearch(location.search, {
    categories: values(categoryCheckboxes),
    candles: values(candleCheckboxes),
    packagings: values(packagingCheckboxes),
  });
  // Enlaces viejos /catalogo#slug: se convierten a ?c=slug.
  const legacySlug = categoryFromHash(location.hash, values(categoryCheckboxes));
  if (legacySlug && initial.categories.length === 0) initial.categories.push(legacySlug);
  if (searchInput) searchInput.value = initial.query;
  const check = (checkboxes: HTMLInputElement[], slugs: string[]) => {
    checkboxes.forEach((checkbox) => { checkbox.checked = slugs.includes(checkbox.value); });
  };
  check(categoryCheckboxes, initial.categories);
  check(candleCheckboxes, initial.candles);
  check(packagingCheckboxes, initial.packagings);
  applyFilters();
</script>

---
import SharedQuote, { type SharedQuoteData } from '../components/SharedQuote.astro';
import Layout from '../layouts/Layout.astro';
import { ApiError, getJson } from '../lib/api';
import { fragranceNote, PRICE_DISCLAIMER, wholesaleNote, type ProductPrices } from '../lib/price';
import { whatsappLink } from '../lib/whatsapp';

interface PublicSettings {
  city: string;
  minLeadTimeDays: number;
  whatsapp: string | null;
  wholesaleThresholdQty?: number;
  fragranceSurcharge?: number;
}

const settings = await getJson<PublicSettings>('/public/settings');

// La lista vive en localStorage sin precios: se leen aqui, vigentes, del
// catalogo publico. Un producto que ya no esta visible no trae precio y su
// renglon queda "a cotizar". Si el catalogo falla, la pagina sigue sirviendo
// para pedir la cotizacion, solo que sin estimado.
const catalog = await getJson<{ products: { id: number; prices?: ProductPrices }[] }[]>('/public/catalog').catch(() => []);
const pricesById = Object.fromEntries(
  catalog.flatMap((category) => category.products).map((product) => [String(product.id), product.prices]),
);
const priceSettings = { wholesaleThresholdQty: settings.wholesaleThresholdQty, fragranceSurcharge: settings.fragranceSurcharge };

// Misma regla que el API: hoy en la zona del negocio + N dias, como fecha pura.
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Mexico_City' }).format(new Date());
const min = new Date(`${today}T00:00:00Z`);
min.setUTCDate(min.getUTCDate() + settings.minLeadTimeDays);
const minEventDate = min.toISOString().slice(0, 10);

const whatsappUrl = whatsappLink(settings.whatsapp);

// Con ?token= se muestra una lista compartida en lugar del carrito; un token
// vacio cuenta como sin token. Un 404 deja la lista en null.
const token = Astro.url.searchParams.get('token');
const shared = token
  ? await getJson<SharedQuoteData>(`/public/shared-quotes/${encodeURIComponent(token)}`)
    .catch((error: unknown) => {
      if (!(error instanceof ApiError) || error.status !== 404) throw error;
      Astro.response.status = 404;
      return null;
    })
  : null;
---

{token ? (
  <Layout title="Lista compartida · Lignum Vitae" description="Lista de productos compartida para cotizar." noindex>
    <section class="site-container py-16 lg:py-24" aria-labelledby="cotizar-title">
      <h1 id="cotizar-title" class="text-display-lg text-brand">Lista compartida</h1>
      <SharedQuote quote={shared} prices={pricesById} priceSettings={priceSettings} />
    </section>
  </Layout>
) : (
  <Layout title="Mi cotización · Lignum Vitae" description="Revisa tus productos y envía tu lista por WhatsApp." noindex>
    <section class="site-container py-16 lg:py-24" aria-labelledby="cotizar-title">
      <h1 id="cotizar-title" class="text-display-lg text-brand">Mi cotización</h1>

      <div id="quote-empty" class="mt-8" hidden>
        <p class="text-body-lg text-text-muted">Aún no agregas productos a tu cotización.</p>
        <a href="/catalogo" class="button mt-6 bg-action text-surface hover:bg-action-hover">Ver catálogo</a>
        {whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener" class="button button-outline mt-6">Escríbenos por WhatsApp</a>}
      </div>

      <div id="quote-content" class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16" hidden>
        <div class="min-w-0">
          <h2 class="text-heading-lg text-brand">Tus productos</h2>
          <ul id="quote-items" class="mt-6 flex flex-col gap-4" data-prices={JSON.stringify(pricesById)} data-price-settings={JSON.stringify(priceSettings)}></ul>
          <div id="quote-summary" class="mt-6 rounded-card bg-surface p-4 shadow-card">
            <dl class="flex items-baseline justify-between gap-4">
              <dt class="text-body font-medium">Total estimado</dt>
              <dd data-total class="text-heading-lg text-brand tabular-nums"></dd>
            </dl>
            <p data-pending class="mt-1 text-caption text-text-muted" hidden></p>
            <p class="mt-2 text-caption text-text-muted">{[PRICE_DISCLAIMER, wholesaleNote(settings.wholesaleThresholdQty), fragranceNote(settings.fragranceSurcharge)].filter(Boolean).join(' ')}</p>
          </div>
        </div>

        <form id="request-form" class="min-w-0 space-y-6 rounded-card bg-surface p-6 shadow-card" data-whatsapp={whatsappUrl} novalidate>
          <h2 class="text-heading-lg text-brand">Enviar tu lista</h2>

          <div class="flex gap-4 rounded-input border-l-[3px] border-action bg-surface-tint p-4 text-body-sm text-text">
            <svg class="shrink-0 text-action" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10v2" /></svg>
            <p>Entregas solo en {settings.city}. Pide con al menos {settings.minLeadTimeDays} días de anticipación. Te confirmamos el precio final por WhatsApp.</p>
          </div>

          <div>
            <label for="event-date" class="block text-body-sm font-medium">¿Para qué fecha lo necesitas? <span class="text-text-muted">(opcional)</span></label>
            <div data-date-picker data-min={minEventDate} class="relative mt-2">
              <input type="hidden" name="eventDate" />
              <button id="event-date" type="button" data-date-trigger aria-haspopup="dialog" aria-expanded="false" aria-describedby="event-date-hint" class="field-input flex items-center gap-2 text-left">
                <svg class="shrink-0 text-text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 2v4m8-4v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" /></svg>
                <span data-date-label class="truncate">Elegir fecha...</span>
              </button>
              <div data-date-popover role="dialog" aria-label="Elegir fecha" hidden class="absolute top-full left-0 z-20 mt-2 w-[18.5rem] rounded-card bg-surface p-3 shadow-float"></div>
            </div>
            <p id="event-date-hint" class="mt-2 text-caption text-text-muted">A partir del {minEventDate.split('-').reverse().join('/')}.</p>
          </div>
          {whatsappUrl ? (
            <>
              <p id="request-error" role="alert" class="rounded-input bg-danger-bg p-4 text-body-sm text-danger-fg" hidden></p>
              <button type="submit" class="button w-full bg-action text-surface hover:bg-action-hover disabled:opacity-60">Enviar por WhatsApp</button>
            </>
          ) : (
            <p class="text-body-sm text-text-muted">Escríbenos desde la página de <a href="/contacto" class="text-action underline">contacto</a>.</p>
          )}
          <button type="button" data-clear class="flex min-h-11 items-center text-body-sm text-action underline">Vaciar lista</button>
        </form>
      </div>
    </section>
  </Layout>
)}

<template id="quote-item-template">
  <li class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-start gap-4 rounded-card bg-surface p-4 shadow-card">
    <img data-image alt="" width="128" height="128" class="aspect-square w-24 rounded-input bg-canvas-deep object-cover md:w-32" />
    <div class="min-w-0">
      <a data-name class="text-heading-sm text-text [overflow-wrap:anywhere] hover:text-action"></a>
      <p data-options class="mt-1 text-caption text-text-muted [overflow-wrap:anywhere]"></p>
      <p data-unit class="mt-2 text-caption text-text-muted"></p>
      <p data-line-total class="text-body font-semibold text-brand tabular-nums"></p>
    </div>
    <div class="flex flex-col items-end gap-2">
      <input data-quantity type="number" min="1" max="5000" step="1" class="field-input w-20 text-center font-semibold" />
      <button data-remove type="button" class="flex min-h-11 items-center text-body-sm text-action underline">Quitar</button>
    </div>
  </li>
</template>

<style>
  /* Calendario de src/lib/date-picker.ts (su HTML se genera en JS, por eso
     :global). Mismas medidas que el DatePicker del admin. */
  :global(.dp-weekday) { padding-bottom: 4px; text-align: center; font-size: var(--text-micro); font-weight: 600; text-transform: uppercase; color: var(--color-text-muted); }
  :global(.dp-day), :global(.dp-nav) { display: flex; height: 40px; align-items: center; justify-content: center; border-radius: 8px; font-size: var(--text-body-sm); color: var(--color-text); }
  :global(.dp-nav) { width: 36px; height: 36px; color: var(--color-text-muted); }
  :global(.dp-day:hover:not([disabled])), :global(.dp-nav:hover:not([disabled])) { background: var(--color-action-soft); }
  :global(.dp-outside) { color: var(--color-border-strong); }
  :global(.dp-today) { font-weight: 700; color: var(--color-action); }
  :global(.dp-day[aria-pressed="true"]) { background: var(--color-action); color: var(--color-surface); }
  :global(.dp-day[disabled]), :global(.dp-nav[disabled]) { opacity: 0.3; cursor: not-allowed; }
</style>

<script>
  import { API_URL } from '../lib/api';
  import { clearQuote, readQuote, removeQuoteItem, updateQuoteItem } from '../lib/quote-list';
  import { initDatePicker } from '../lib/date-picker';
  import { estimateLine, estimateTotal, formatPrice, type LineEstimate, type PriceSettings, type ProductPrices } from '../lib/price';

  // La vista de lista compartida no tiene carrito: sin formulario no se arranca.
  if (document.querySelector('#request-form')) {
    const content = document.querySelector<HTMLElement>('#quote-content')!;
    const empty = document.querySelector<HTMLElement>('#quote-empty')!;
    const list = document.querySelector<HTMLUListElement>('#quote-items')!;
    const template = document.querySelector<HTMLTemplateElement>('#quote-item-template')!;
    const form = document.querySelector<HTMLFormElement>('#request-form')!;
    const datePicker = form.querySelector<HTMLElement>('[data-date-picker]')!;
    const eventDate = datePicker.querySelector<HTMLInputElement>('input[name=eventDate]')!;
    initDatePicker(datePicker, { min: datePicker.dataset.min! });
    const summary = document.querySelector<HTMLElement>('#quote-summary')!;
    const summaryTotal = summary.querySelector<HTMLElement>('[data-total]')!;
    const summaryPending = summary.querySelector<HTMLElement>('[data-pending]')!;
    const pricesById: Record<string, ProductPrices | undefined> = JSON.parse(list.dataset.prices ?? '{}');
    const priceSettings: PriceSettings = JSON.parse(list.dataset.priceSettings ?? '{}');
    const tierLabel = { retail: 'Menudeo', wholesale: 'Mayoreo' } as const;

    const render = () => {
      const items = readQuote();
      const estimates: (LineEstimate | null)[] = items.map((item) => estimateLine(item, pricesById[item.productId], priceSettings));
      content.hidden = items.length === 0;
      empty.hidden = items.length > 0;
      list.replaceChildren(
        ...items.map((item, index) => {
          const row = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
          const image = row.querySelector<HTMLImageElement>('[data-image]')!;
          image.src = item.imageUrl;
          const name = row.querySelector<HTMLAnchorElement>('[data-name]')!;
          name.textContent = item.name;
          name.href = `/producto/${encodeURIComponent(item.slug)}`;
          row.querySelector('[data-options]')!.textContent = [
            item.candleColor && `Vela: ${item.candleColor}`,
            ...item.extraFields.map((field) => `${field.label}: ${field.value}`),
            item.withFragrance ? `Aroma: ${item.fragranceName || 'sin especificar'}` : 'Sin aroma',
          ].filter(Boolean).join(' · ');
          const estimate = estimates[index];
          row.querySelector('[data-unit]')!.textContent = estimate
            ? `${tierLabel[estimate.tier]} · ${formatPrice(estimate.unitPrice)} c/u${item.withFragrance && priceSettings.fragranceSurcharge ? ' (aroma incluido)' : ''}`
            : 'Precio a cotizar';
          row.querySelector('[data-line-total]')!.textContent = estimate ? formatPrice(estimate.lineTotal) : '';
          const quantity = row.querySelector<HTMLInputElement>('[data-quantity]')!;
          quantity.value = String(item.quantity);
          quantity.setAttribute('aria-label', `Cantidad de ${item.name}`);
          quantity.addEventListener('change', () => {
            const value = quantity.valueAsNumber;
            if (Number.isInteger(value) && value >= 1 && value <= 5000) updateQuoteItem(index, { quantity: value });
            else quantity.value = String(item.quantity);
          });
          const remove = row.querySelector<HTMLButtonElement>('[data-remove]')!;
          remove.setAttribute('aria-label', `Quitar ${item.name}`);
          remove.addEventListener('click', () => removeQuoteItem(index));
          return row;
        }),
      );
      const { total, pending } = estimateTotal(estimates);
      // Sin ningun renglon con precio no hay nada que estimar.
      summary.hidden = pending === items.length;
      summaryTotal.textContent = formatPrice(total);
      summaryPending.hidden = pending === 0;
      summaryPending.textContent = pending === 1 ? 'No incluye 1 producto a cotizar.' : `No incluye ${pending} productos a cotizar.`;
    };

    const errorFor = (status: number, code: string | undefined) => {
      if (status === 429) return 'Espera un minuto e intenta de nuevo.';
      if (code === 'PRODUCT_NOT_FOUND') {
        return 'Uno o más productos ya no están disponibles. Quítalos de tu cotización e intenta de nuevo.';
      }
      if (code === 'INVALID_FRAGRANCE_SUPPLY') {
        return 'Uno de los aromas elegidos ya no está disponible. Vuelve a elegirlo e intenta de nuevo.';
      }
      return 'No pudimos preparar tu lista. Revisa tu conexión e intenta de nuevo.';
    };

    // Guarda la lista en el API y manda por WhatsApp un saludo con su enlace. La
    // fecha es opcional y la lista se conserva despues de enviarla.
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const items = readQuote();
      if (!items.length) return render();
      // Sin numero de WhatsApp no hay boton de envio ni caja de error.
      const submit = form.querySelector<HTMLButtonElement>('button[type=submit]');
      if (!submit) return;
      const errorBox = form.querySelector<HTMLElement>('#request-error')!;
      errorBox.hidden = true;
      const originalText = submit.textContent;
      submit.textContent = 'Preparando…';
      submit.setAttribute('aria-busy', 'true');
      submit.disabled = true;
      // La ventana se abre antes del fetch para que el navegador no la bloquee.
      const win = window.open('', '_blank');
      if (win) win.opener = null;
      const showError = (message: string) => {
        win?.close();
        errorBox.textContent = message;
        errorBox.hidden = false;
      };
      try {
        const response = await fetch(`${API_URL}/public/shared-quotes`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            eventDate: eventDate.value || undefined,
            items: items.map((item) => ({
              productId: Number(item.productId),
              quantity: item.quantity,
              candleColor: item.candleColor || undefined,
              extraFields: item.extraFields.length ? item.extraFields.map(({ supplyId, value }) => ({ supplyId, value })) : undefined,
              withFragrance: item.withFragrance,
              fragranceSupplyId: item.withFragrance && item.fragranceId ? Number(item.fragranceId) : undefined,
            })),
          }),
        });
        if (!response.ok) {
          const body: { code?: string } | null = await response.json().catch(() => null);
          showError(errorFor(response.status, body?.code));
          return;
        }
        const { data } = await response.json();
        const url = `${form.dataset.whatsapp}?text=${encodeURIComponent(`Hola, quiero cotizar:\n${location.origin}/cotizar?token=${data.token}`)}`;
        if (win) win.location.href = url;
        else location.href = url;
      } catch {
        showError(errorFor(0, undefined));
      } finally {
        submit.disabled = false;
        submit.textContent = originalText;
        submit.removeAttribute('aria-busy');
      }
    });

    form.querySelector<HTMLButtonElement>('[data-clear]')!.addEventListener('click', () => {
      if (confirm('¿Vaciar tu lista de cotización?')) clearQuote();
    });

    render();
    window.addEventListener('quote:change', render);
    window.addEventListener('storage', render);
  }
</script>

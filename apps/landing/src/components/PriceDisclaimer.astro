---
import { fragranceNote, PRICE_DISCLAIMER, wholesaleNote } from '../lib/price';

interface Props {
  /** Settings.wholesaleThresholdQty; si no llega, solo se muestra el aviso. */
  wholesaleThresholdQty?: number | null;
  /** Settings.fragranceSurcharge; si no llega, no se menciona el aroma. */
  fragranceSurcharge?: number | null;
  class?: string;
}

const { wholesaleThresholdQty, fragranceSurcharge, class: className } = Astro.props;
---

<p class:list={['text-caption text-text-muted', className]}>
  {[PRICE_DISCLAIMER, wholesaleNote(wholesaleThresholdQty), fragranceNote(fragranceSurcharge)].filter(Boolean).join(' ')}
</p>

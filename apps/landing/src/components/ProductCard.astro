---
import { imageUrl } from '../lib/api';
import { formatPrice, type ProductPrices } from '../lib/price';

export interface Product {
  name: string;
  slug: string;
  isFeatured: boolean;
  isNew?: boolean;
  image: { url: string; alt: string | null } | null;
  candles?: { name: string; slug: string }[];
  packagingType?: { name: string; slug: string } | null;
  prices?: ProductPrices;
}

interface Props {
  product: Product;
  /** Slug de la categoria que envuelve esta tarjeta, para el filtro del catalogo. */
  categorySlug?: string;
}

const { product, categorySlug } = Astro.props;
const candleSlugs = (product.candles ?? []).map((c) => c.slug).join(',');
const prices = [
  { label: 'Menudeo', value: product.prices?.retail ?? null },
  { label: 'Mayoreo', value: product.prices?.wholesale ?? null },
];
const hasPrice = prices.some((price) => price.value !== null);
---

<a
  href={`/producto/${encodeURIComponent(product.slug)}`}
  class="product-card block min-w-0 rounded-card bg-surface shadow-card"
  data-category={categorySlug}
  data-candles={candleSlugs}
  data-packaging={product.packagingType?.slug ?? ''}
>
  <div class="relative overflow-hidden rounded-t-card bg-canvas-deep">
    <img
      src={product.image ? imageUrl(product.image.url) : '/logo.svg'}
      alt={product.image?.alt || product.name}
      loading="lazy"
      decoding="async"
      class:list={['product-image aspect-[4/5] w-full', product.image ? 'object-cover' : 'object-contain p-6']}
    />
    {(product.isNew || product.isFeatured) && <div class="absolute top-4 left-4 flex flex-col items-start gap-1">
      {product.isNew && <span class="rounded-full bg-action px-2 py-1 text-micro text-surface">Nuevo</span>}
      {product.isFeatured && <span class="rounded-full bg-action-soft px-2 py-1 text-micro text-brand">Destacado</span>}
    </div>}
  </div>
  <div class="p-4">
    <h3 class="text-heading-sm text-text [overflow-wrap:anywhere]">{product.name}</h3>
    {hasPrice ? <dl class="mt-2 space-y-1">
      {prices.map((price) => <div class="flex flex-wrap items-baseline justify-between gap-x-2">
        <dt class="text-caption text-text-muted">{price.label}</dt>
        <dd class:list={['text-body-sm tabular-nums', price.value !== null ? 'font-semibold text-brand' : 'text-text-muted']}>{price.value !== null ? formatPrice(price.value) : 'A cotizar'}</dd>
      </div>)}
    </dl> : <p class="mt-2 text-body-sm text-text-muted">Precio a cotizar</p>}
  </div>
</a>

<style>
  .product-image { opacity: 0; transition: opacity .3s ease-in, transform .4s var(--ease-out); }
  .product-image.loaded { opacity: 1; }
  .product-card:hover .product-image { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .product-image { transition: none; }
    .product-card:hover .product-image { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>('.product-image').forEach((image) => {
    if (image.complete) image.classList.add('loaded');
    else image.addEventListener('load', () => image.classList.add('loaded'), { once: true });
  });
</script>

<noscript><style is:inline>.product-image { opacity: 1; }</style></noscript>

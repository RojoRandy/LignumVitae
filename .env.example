# ---------------------------------------------------------------------------
# Base de datos (consumido por docker-compose.yml y por Prisma)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5434
DB_USER=lignumvitae
DB_PASSWORD=lignumvitae
DB_NAME=lignumvitae
DATABASE_URL="postgresql://lignumvitae:lignumvitae@localhost:5434/lignumvitae?schema=public"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRATION=8h

# URL publica de la landing. Se usa para armar el link de la cotizacion
# que se envia al cliente: ${PUBLIC_SITE_URL}/cotizacion/:token
PUBLIC_SITE_URL=http://localhost:4321

# Origenes permitidos por CORS, separados por coma
# 5174 es el puerto al que Vite salta solo si el 5173 ya esta ocupado
# (otra instancia de "pnpm dev" corriendo) -- se deja permitido de una vez
# para no volver a toparse con un 401/CORS silencioso por esto.
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:5174

# Carpeta local donde se guardan las imagenes subidas desde el admin
UPLOADS_DIR=./uploads

# Proveedor de almacenamiento: local (disco) o s3.
STORAGE_DRIVER=local
# Requeridas solo para STORAGE_DRIVER=s3. El bucket debe permitir lectura publica.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional: URL publica del bucket/CDN, sin slash final.
S3_PUBLIC_BASE_URL=
# Opcional: "carpeta" dentro del bucket (sin slashes al inicio/final), para
# compartir un mismo bucket entre ambientes sin que se pisen los archivos.
# Ej: development | production. Vacio = objetos en la raiz del bucket.
S3_KEY_PREFIX=

# Credenciales del usuario sembrado por prisma/seed.ts
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!

# ---------------------------------------------------------------------------
# Front-end (apps/admin y apps/landing)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:3000/api
